modules = ["python-3.11"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Snapshotter"

[[workflows.workflow]]
name = "Run Snapshotter"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python main.py"

[workflows.workflow.metadata]
outputType = "console"

[nix]
packages = ["libxcrypt"]

[userenv]

[userenv.shared]
SNAPSHOTTER_DRY_RUN = "false"
SNAPSHOTTER_JOB_JSON = "{   \"repo_url\": \"https://github.com/stepan-o/fruitful-lab.git\",   \"ref\": \"main\",   \"mode\": \"full\",   \"limits\": {     \"max_file_bytes\": 10485760,     \"max_total_bytes\": 262144000,     \"max_files\": 20000   },   \"filters\": {     \"deny_dirs\": [\"node_modules\", \".git\", \".next\", \"dist\", \"build\", \".venv\"],     \"allow_exts\": [\"*\"]   },   \"output\": {     \"s3_bucket\": \"fruitful-lab-snapshots-prod\",     \"s3_prefix\": \"repo-scans/snapshotter\"   },   \"metadata\": {     \"triggered_by\": \"manual\",     \"notes\": \"replit run\"   } }"
SNAPSHOTTER_USE_LANGGRAPH = "true"
