modules = ["python-3.11"]
[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Snapshotter"

[[workflows.workflow]]
name = "Run Snapshotter"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "uv run python main.py"

[workflows.workflow.metadata]
outputType = "console"

[nix]
packages = ["libxcrypt"]

[userenv]

[userenv.shared]
SNAPSHOTTER_S3_PREFIX = "repo-scans/snapshotter"
SNAPSHOTTER_DRY_RUN = "false"
SNAPSHOTTER_REF = "main"
